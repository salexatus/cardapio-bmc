# ===== BMC backend — .env de PRODUÇÃO (copie p/ backend/.env no servidor) =====
# NUNCA commitar. Gere SECRET_KEY forte e use a senha real do Postgres.
# Os valores reais ficam em credencias.md (na raiz do repo, gitignored).

SECRET_KEY=GERAR_UM_SEGREDO_LONGO_E_ALEATORIO
DEBUG=False
ALLOWED_HOSTS=apicardapiobmc.limadesigner.com.br

# --- PostgreSQL de produção (banco criado no CloudPanel) ---
POSTGRES_DB=PREENCHER
POSTGRES_USER=PREENCHER
POSTGRES_PASSWORD=PREENCHER
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- JWT / cookies httpOnly ---
JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=7
AUTH_COOKIE_ACCESS=bmc_access
AUTH_COOKIE_REFRESH=bmc_refresh
# Frontend (Cloudflare) e backend (VPS) são sites diferentes → cross-site:
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=None

# --- Rate limit do login ---
THROTTLE_LOGIN=10/min

# --- CORS/CSRF: origem do frontend em produção (com protocolo) ---
CORS_ALLOWED_ORIGINS=https://cardapio.limadesigner.com.br
CSRF_TRUSTED_ORIGINS=https://cardapio.limadesigner.com.br

# --- HTTPS ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=2592000
