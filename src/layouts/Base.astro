---
// Shell estático do site (SEO/OG/JSON-LD/fontes/PWA). O conteúdo interativo
// entra como ilha React via <slot/>. Ver src/pages/index.astro e admin.astro.
import '../index.css'

const {
  title = 'Balneário Monte Castelo | Cardápio às margens do Rio Urupá',
  description = 'Balneário Monte Castelo — comida no fogão a lenha, música ao vivo e ambiente familiar às margens do Rio Urupá. Veja o cardápio digital, porções, hambúrgueres, drinks e eventos.',
  noindex = false,
} = Astro.props

const ogImage =
  'https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1200&q=70'

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Balneário Monte Castelo',
  description:
    'Restaurante e balneário às margens do Rio Urupá, com comida no fogão a lenha, música ao vivo e ambiente familiar.',
  servesCuisine: ['Brasileira', 'Regional', 'Porções', 'Hambúrgueres'],
  priceRange: '$$',
  image: ogImage,
  url: 'https://balneariomontecastelo.com.br/',
  telephone: '+55-69-99999-9999',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ji-Paraná',
    addressRegion: 'RO',
    addressCountry: 'BR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: -10.8853, longitude: -61.9514 },
  openingHours: 'Tu-Su 09:00-23:00',
})
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1B4332" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Balneário Monte Castelo, Rio Urupá, restaurante beira rio, fogão a lenha, cardápio digital, porções, hambúrguer, drinks, música ao vivo, Rondônia"
    />
    <meta name="author" content="Balneário Monte Castelo" />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
    <link rel="canonical" href="https://balneariomontecastelo.com.br/" />

    <!-- Open Graph -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:site_name" content="Balneário Monte Castelo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content="https://balneariomontecastelo.com.br/" />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Ícones / PWA -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Monte Castelo" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://images.unsplash.com" />

    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <!-- Registra o service worker (PWA instalável + cache offline) -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {})
        })
      }
    </script>
  </head>
  <body>
    <slot />
    <noscript>Para visualizar o cardápio do Balneário Monte Castelo, ative o JavaScript no seu navegador.</noscript>
  </body>
</html>
