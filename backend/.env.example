# ===== BMC backend — .env de DESENVOLVIMENTO =====
# Copie para backend/.env. Sem POSTGRES_DB, usa SQLite automaticamente.

SECRET_KEY=dev-inseguro-trocar-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend local (Vite). Cookies em dev são Lax e não-secure.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Para usar Postgres localmente, defina POSTGRES_DB (e os demais):
# POSTGRES_DB=bmc
# POSTGRES_USER=bmc
# POSTGRES_PASSWORD=...
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
